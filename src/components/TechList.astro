---
interface Props {
  label?: string;
  items: string[];
}
const { label = 'Built with', items } = Astro.props;
---

<div class="mt-6">
  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{label}</p>
  <ul class="mt-2 flex flex-wrap gap-2">
    {items.map((item) => <li class="rounded-md bg-slate-100 px-2 py-1 text-sm text-slate-700">{item}</li>)}
  </ul>
</div>
