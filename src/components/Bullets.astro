---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="mt-3 space-y-2 text-slate-700">
  {
    items.map((item) => (
      <li class="flex gap-2">
        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ocean-500" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
