---
import { nav } from '../data/site';
---

<header class="sticky top-0 z-10 border-b border-slate-200/70 bg-white/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="#top" class="font-semibold tracking-tight text-slate-900">Waheed Odubayo</a>
    <nav aria-label="Sections" class="hidden sm:block">
      <ul class="flex gap-6 text-sm text-slate-600">
        {nav.map((item) => <li><a href={item.href} class="hover:text-ocean-600">{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
