---
import { links } from '../data/site';
---

<section id="top" class="mx-auto max-w-5xl px-4 pb-20 pt-16 sm:pb-28 sm:pt-24">
  <p class="text-sm font-semibold uppercase tracking-wide text-ocean-600">
    Software engineer · Product builder
  </p>
  <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl">
    I build software that turns messy real-world data into decisions.
  </h1>
  <p class="mt-6 max-w-2xl text-lg text-slate-600 sm:text-xl">
    20+ years shipping production systems — now building products for households, cities, and
    coastlines.
  </p>
  <div class="mt-10 flex flex-wrap gap-3">
    <a
      href="#products"
      class="rounded-md bg-ocean-600 px-5 py-2.5 font-medium text-white shadow-sm hover:bg-ocean-700"
    >
      See the products
    </a>
    <a href={links.github} class="rounded-md border border-slate-300 px-5 py-2.5 font-medium hover:bg-slate-50">
      GitHub
    </a>
    <a href={links.linkedin} class="rounded-md border border-slate-300 px-5 py-2.5 font-medium hover:bg-slate-50">
      LinkedIn
    </a>
  </div>
</section>
