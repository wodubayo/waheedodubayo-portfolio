---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import TechList from './TechList.astro';
import Bullets from './Bullets.astro';
import { links } from '../data/site';
import { lagos } from '../data/lagos';
import heroMap from '../assets/images/lagos-hero-map.png';
---

<article id="lagos" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
  <div class="flex flex-wrap items-center gap-2">
    <Tag>Geospatial pipeline</Tag>
    <Tag tone="progress">In progress</Tag>
  </div>
  <h3 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">{lagos.title}</h3>
  <p class="mt-4 max-w-2xl text-lg text-slate-600">{lagos.intro}</p>

  <figure class="mt-8">
    <Image
      src={heroMap}
      alt="Map of the Lagos coast with small candidate patches along the coastline and lagoons"
      widths={[640, 960, 1600]}
      sizes="(min-width: 1024px) 896px, 100vw"
      class="w-full rounded-lg border border-slate-200"
      loading="lazy"
    />
    <figcaption class="mt-2 text-sm text-slate-500">{lagos.mapCaption}</figcaption>
  </figure>

  <div class="mt-10 grid gap-8 lg:grid-cols-2">
    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Progress so far</h4>
      <Bullets items={lagos.progress} />
    </div>
    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Why “candidates,” not “floods”</h4>
      <p class="mt-3 text-slate-700">{lagos.whyCandidates}</p>
      <TechList items={lagos.tech} />
    </div>
  </div>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="/lagos" class="rounded-md bg-ocean-600 px-5 py-2.5 font-medium text-white hover:bg-ocean-700">
      See the full pipeline →
    </a>
    <a href={links.lagosRepo} class="rounded-md border border-slate-300 px-5 py-2.5 font-medium hover:bg-slate-50">
      GitHub
    </a>
  </div>
</article>
