---
// Decorative bathymetric contour lines, generated at build time.
// Concentric rings perturbed by a few low-frequency sine waves give an
// organic, depth-chart look without shipping any JavaScript.

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const W = 800;
const H = 600;
const centers = [
  { x: 620, y: 260, rings: 14, step: 26, seed: 1.3 },
  { x: 180, y: 520, rings: 7, step: 30, seed: 4.1 },
];

function ring(cx: number, cy: number, r: number, seed: number): string {
  const pts: string[] = [];
  const n = 96;
  for (let i = 0; i <= n; i++) {
    const t = (i / n) * Math.PI * 2;
    const wobble =
      1 +
      0.12 * Math.sin(3 * t + seed) +
      0.07 * Math.sin(5 * t + seed * 2.3 + r / 60) +
      0.04 * Math.sin(9 * t + seed * 0.7);
    const x = cx + r * 1.25 * wobble * Math.cos(t);
    const y = cy + r * wobble * Math.sin(t);
    pts.push(`${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return pts.join(' ') + 'Z';
}

const paths = centers.flatMap((c) =>
  Array.from({ length: c.rings }, (_, k) => ({
    d: ring(c.x, c.y, 18 + k * c.step, c.seed),
    strong: k % 5 === 4, // every fifth line is an "index contour", like a real chart
  })),
);
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="contour-fade" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="white" stop-opacity="0" />
      <stop offset="0.45" stop-color="white" stop-opacity="0.6" />
      <stop offset="1" stop-color="white" stop-opacity="1" />
    </linearGradient>
    <mask id="contour-mask">
      <rect width={W} height={H} fill="url(#contour-fade)" />
    </mask>
  </defs>
  <g mask="url(#contour-mask)" fill="none" stroke="currentColor">
    {paths.map((p) => <path d={p.d} stroke-width={p.strong ? 1.4 : 0.8} opacity={p.strong ? 0.55 : 0.35} />)}
  </g>
</svg>
